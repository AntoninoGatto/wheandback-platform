# Storefront pubblico (apps/storefront-next).
# Copia in .env.local per lo sviluppo. Su Vercel imposta le stesse chiavi
# nel progetto la cui Root Directory è apps/storefront-next.
# Non committare .env.local. Non mettere segreti (solo chiavi pubbliche NEXT_PUBLIC_).

# Origine della Mercur API, senza slash finale.
# Locale: http://localhost:9000
# Dopo il deploy Railway: https://<servizio>.up.railway.app
# Il dominio wheback.com / api.wheback.com NON va usato in questo blocco.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key (pk_...) dal seed o da Admin → Settings → Publishable API Keys.
# Il build passa anche con questo placeholder; lo shop risponde 401 finché non è quella vera.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder_replace_me

# Paese (ISO-2) della region Medusa usata per carrello e prezzi. Default Italia.
NEXT_PUBLIC_DEFAULT_REGION_COUNTRY=it

# Publishable Stripe (pk_test_… poi pk_live_…). Vuoto = il checkout mostra solo il messaggio di config.
NEXT_PUBLIC_STRIPE_PK=
