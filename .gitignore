# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Cursor local handoff / transfer (SSD-first; do not push secrets or dumps)
.cursor/CHAT-EXPORT*.md
.cursor/transcripts-raw/
.cursor/transfer/*.sql
.cursor/transfer/*.dump
.cursor/transfer/*.tar
.cursor/transfer/*.gz
.cursor/local/
.cursor/*.log

# Accidental / local noise (do not commit)
services/mercur-marketplacenpm.cmd/
**/.env.bak*
**/.env.bak-*/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
