# Supabase (attuale — fase prototipo)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL pubblico del sito (link inviti partner, email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (checkout — non ancora configurato in produzione)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# CJ Dropshipping API
CJ_API_KEY=your_cj_api_key

# OpenAI (descrizioni prodotti, traduzione ricerche)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY

# Protezione endpoint cron
CRON_SECRET=use_a_long_random_string_here
