# Mercur API (services/mercur-marketplace/packages/api).
# Copia in .env per lo sviluppo locale. Sul hosting imposta le stesse chiavi
# nel pannello (non committare .env). I valori qui sono segnaposto.

# --- Database e Redis ---
# Locale (infrastructure/docker/docker-compose.yml, Postgres sull'host 5433):
DATABASE_URL=postgres://wheback:wheback_dev@localhost:5433/wheback_medusa
# Produzione: URL privato del Postgres gestito. Non riusare la password di sviluppo.
# true solo se il provider richiede TLS (URL pubblico Railway). Sull'URL privato lascia false.
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# --- Secret (openssl rand -base64 32). Mai "supersecret" né questi placeholder in produzione. ---
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-different-long-random-string

# --- CORS ---
# Lista separata da virgole, senza spazi.
# Le origini che iniziano e finiscono con @ sono regex Medusa (niente flag g).
# Copre ogni preview e production *.vercel.app. Non è un glob letterale https://*.vercel.app.
# Il dominio wheback.com si aggiunge solo al cutover DNS, non in questo blocco.
STORE_CORS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8000,@^https://[a-zA-Z0-9.-]+\.vercel\.app$@
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8000,http://localhost:7000,http://localhost:7001,http://localhost:9000,@^https://[a-zA-Z0-9.-]+\.vercel\.app$@

# --- Processo ---
# Railway inietta PORT. In locale Medusa usa 9000.
# PORT=9000
# Il container di produzione imposta NODE_ENV=production. Non forzarlo nel .env locale.
MEDUSA_WORKER_MODE=shared

# --- URL pubblici ---
# MERCUR_BACKEND_URL è usata a BUILD TIME dei pannelli admin/vendor (ARG Docker).
# Deve essere l'origine pubblica dell'API, senza slash finale. Poi rifai il deploy.
MERCUR_BACKEND_URL=http://localhost:9000
# Link invito vendor. In produzione: https://<api-host>/seller
MERCUR_VENDOR_URL=http://localhost:7001
# Origine scritta dentro gli URL dei file caricati (provider locale).
FILE_BACKEND_URL=http://localhost:9000/static

# --- Stripe (opzionale in questo blocco; lascia vuoto finché non fai il test) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Non impostare in produzione. Serve solo allo smoke test locale/CI.
# ALLOW_INSECURE_SECRETS=
